---
import { render } from 'astro:content';
import Sec from './Sec.astro';
import Card from './Card.astro';
import Subscribe from './Subscribe.astro';
import { sayininYazilari, okumaSuresi, pad, aralik, tarihUzun, konuUrl, type Sayi } from '../lib/site';
import { konuAdi } from '../lib/konular';

interface Props { sayi: Sayi; arsiv?: boolean }
const { sayi, arsiv = false } = Astro.props;
const s = sayi.data;
const { Content } = await render(sayi);
const liste = await sayininYazilari(s.sayi);
const toplam = liste.reduce((t, y) => t + okumaSuresi(y), 0);

// 3'lü satırlar; son hücre abonelik kutusu (yalnızca güncel sayıda)
const hucreler: ({ tip: 'yazi'; i: number } | { tip: 'abone' })[] = liste.map((_, i) => ({ tip: 'yazi' as const, i }));
if (!arsiv) hucreler.push({ tip: 'abone' });
const satirlar = [];
for (let i = 0; i < hucreler.length; i += 3) satirlar.push(hucreler.slice(i, i + 3));
---
<div class:list={['issue', { 'issue--arsiv': arsiv }]}>
  {arsiv && (
    <p class="notice">Bu bir arşiv sayısı. <a href="/">Güncel sayıya git →</a></p>
  )}

  <section class="ozet" aria-labelledby="ozet-baslik">
    <Sec harf={pad(s.sayi)} as="div" aside={aralik(s.baslangic, s.bitis)}>Sayı {pad(s.sayi)}</Sec>

    <div class="ozet__grid">
      <div class="ozet__main">
        <h1 class="ozet__title" id="ozet-baslik">{s.baslik}</h1>
        <div class="ozet__note"><Content /></div>
        <p class="ozet__sign">— {s.imza}</p>
      </div>
      <aside class="ozet__side">
        <dl class="facts">
          <div><dt>Yayın</dt><dd>{tarihUzun(s.yayin)}</dd></div>
          <div><dt>Yazı</dt><dd>{liste.length}</dd></div>
          <div><dt>Toplam okuma</dt><dd>{toplam} dk</dd></div>
        </dl>
        <div class="rakam">
          <span class="rakam__label">Haftanın rakamı</span>
          <span class:list={['rakam__value', { 'rakam__value--uzun': s.rakam.deger.length > 4 }]}>{s.rakam.deger}</span>
          <p>{s.rakam.aciklama}</p>
        </div>
      </aside>
    </div>

    <div class="kisa">
      <h3 class="kisa__title">Bu hafta kısa kısa</h3>
      <ol>
        {s.kisaKisa.map((k, i) => (
          <li>
            <span class="kisa__no">{pad(i + 1)}</span>
            <a class="kisa__konu" href={konuUrl(k.konu)}>{konuAdi(k.konu)}</a>
            <span class="kisa__metin">{k.metin}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="gundem" aria-labelledby="gundem-baslik">
    <Sec harf="G" aside={`${liste.length} yazı · ${toplam} dk`} id="gundem-baslik">Bu haftanın yazıları</Sec>
    {satirlar.map((satir, r) => (
      <div class="row">
        {satir.map((h) => h.tip === 'abone'
          ? <Subscribe variant="box" kaynak={`sayi-${s.sayi}`} />
          : <Card yazi={liste[h.i]} eager={r === 0} />)}
      </div>
    ))}
  </section>

  <a class="more" href="/arsiv/"><span>Önceki sayılar</span><span>Arşiv →</span></a>
</div>
