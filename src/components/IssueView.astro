---
import { render } from 'astro:content';
import Sec from './Sec.astro';
import Card from './Card.astro';
import Subscribe from './Subscribe.astro';
import { sayininYazilari, okumaSuresi, pad, aralik, konuUrl, yaziUrl, type Sayi } from '../lib/site';
import { konuAdi } from '../lib/konular';

interface Props { sayi: Sayi; arsiv?: boolean }
const { sayi, arsiv = false } = Astro.props;
const s = sayi.data;
const { Content } = await render(sayi);
const liste = await sayininYazilari(s.sayi);
const toplam = liste.reduce((t, y) => t + okumaSuresi(y), 0);

// 3'lü satırlar; son hücre abonelik kutusu (yalnızca güncel sayıda)
const hucreler: ({ tip: 'yazi'; i: number } | { tip: 'abone' })[] = liste.map((_, i) => ({ tip: 'yazi' as const, i }));
if (!arsiv) hucreler.push({ tip: 'abone' });
const satirlar = [];
for (let i = 0; i < hucreler.length; i += 3) satirlar.push(hucreler.slice(i, i + 3));
---
<div class:list={['issue', { 'issue--arsiv': arsiv }]}>
  {arsiv && (
    <p class="notice">Bu bir arşiv sayısı. <a href="/">Güncel sayıya git →</a></p>
  )}

  <section class="ozet" aria-labelledby="ozet-baslik">
    <div class="ozet__bar">
      <span>Sayı {pad(s.sayi)}</span>
      <span>{aralik(s.baslangic, s.bitis)}</span>
      <span>{liste.length} yazı · {toplam} dk</span>
    </div>

    <h1 class="ozet__title" id="ozet-baslik">{s.baslik}</h1>

    <div class="ozet__note">
      <nav class="ozet__toc" aria-label="Bu sayıda">
        <span class="label">Bu sayıda</span>
        <ol>
          {liste.map((y) => (
            <li>
              <a href={yaziUrl(y)}>
                <span class="ozet__tocno">{pad(y.data.sira)}</span>
                <span class="ozet__toct">{y.data.baslik}</span>
                <span class="ozet__tocdk">{okumaSuresi(y)} dk</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="ozet__text">
        <span class="label">Bu hafta</span>
        <Content />
        <p class="ozet__sign">— {s.imza}</p>
      </div>
    </div>

    <div class="olan">
      <span class="label olan__label">Ne oldu?</span>
      <ol class="olan__list" style={`--n: ${s.kisaKisa.length}`}>
        {s.kisaKisa.map((k, i) => (
          <li>
            <p>{k.metin}</p>
            <div class="olan__meta">
              <a href={konuUrl(k.konu)}>{konuAdi(k.konu)}</a>
              <span class="olan__no">{pad(i + 1)}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>

  </section>

  <section class="gundem" aria-labelledby="gundem-baslik">
    <Sec aside={`${liste.length} yazı · ${toplam} dk`} id="gundem-baslik">Bu haftanın yazıları</Sec>
    {satirlar.map((satir, r) => (
      <div class="row">
        {satir.map((h) => h.tip === 'abone'
          ? <Subscribe variant="box" kaynak={`sayi-${s.sayi}`} />
          : <Card yazi={liste[h.i]} eager={r === 0} />)}
      </div>
    ))}
  </section>

  <a class="more" href="/arsiv/"><span>Önceki sayılar</span><span>Arşiv →</span></a>
</div>
