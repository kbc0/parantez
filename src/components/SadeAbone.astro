---
// Sade sayfalardaki abonelik formu (Hakkında'daki gibi): JavaScript'le yerinde, olmadan /api/abone'ye gider.
interface Props { kaynak: string; id?: string }
const { kaynak, id = 'sade-eposta' } = Astro.props;
---
<form class="yz-abone__form" action="/api/abone" method="post">
  <input type="hidden" name="kaynak" value={kaynak}>
  <input class="hp" type="text" name="web" tabindex="-1" autocomplete="off" aria-hidden="true">
  <label class="sr" for={id}>E-posta adresin</label>
  <input id={id} name="eposta" type="email" inputmode="email" autocomplete="email" enterkeyhint="send" autocapitalize="off" spellcheck="false" placeholder="e-posta adresin" required>
  <button class="send" type="submit" aria-label="Abone ol">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
  </button>
</form>
<p class="yz-abone__uyari" data-uyari hidden role="status"></p>
