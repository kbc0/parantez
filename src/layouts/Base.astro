---
import '@fontsource-variable/inter-tight';
import '../styles/global.css';
import { SITE, sayilar, sayininYazilari, yaziUrl, pad, tarihUzun } from '../lib/site';
import { KONULAR } from '../lib/konular';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description = SITE.aciklama, image, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.ad}` : `${SITE.ad} — ${SITE.slogan}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/og.png', Astro.site);

const [guncel] = await sayilar();
const icindekiler = guncel ? await sayininYazilari(guncel.data.sayi) : [];
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title={SITE.ad} href="/rss.xml">
  <meta name="theme-color" content="#ffffff">
  <meta property="og:type" content={type}>
  <meta property="og:site_name" content={SITE.ad}>
  <meta property="og:locale" content="tr_TR">
  <meta property="og:title" content={title ?? SITE.ad}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
</head>
<body>
  <a class="skip" href="#icerik">İçeriğe geç</a>
  <div class="wrap">
    <header class="top">
      <a href="/" class="logo" aria-label="(parantez) ana sayfa">(p)</a>
      <div class="top__right">
        <a href="/abone/" class="top__link">Abone ol</a>
        <div class="toc-wrap">
          <button class="toc" type="button" aria-expanded="false" aria-controls="icindekiler" data-toc-btn>
            <span>İçindekiler</span>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          </button>
          <nav id="icindekiler" class="dropdown" aria-label="İçindekiler" hidden data-toc>
            {guncel && (
              <>
                <a class="dropdown__head" href="/">Sayı {pad(guncel.data.sayi)} · {tarihUzun(guncel.data.yayin)}</a>
                <ol>
                  {icindekiler.map((y) => (
                    <li><a href={yaziUrl(y)}><span class="dropdown__no">{pad(y.data.sira)}</span>{y.data.baslik}</a></li>
                  ))}
                </ol>
              </>
            )}
            <div class="dropdown__konular">
              {Object.entries(KONULAR).map(([k, ad]) => <a href={`/konu/${k}/`}>{ad}</a>)}
            </div>
            <div class="dropdown__foot">
              <a href="/arsiv/">Arşiv</a>
              <a href="/hakkinda/">Hakkında</a>
              <a href="/abone/">Abone ol</a>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <main id="icerik">
      <slot />
    </main>

    <footer class="foot">
      <div class="foot__row">
        <a href="/" class="foot__mark">(parantez)</a>
        <nav class="foot__nav" aria-label="Alt menü">
          <a href="/arsiv/">Arşiv</a>
          <a href="/hakkinda/">Hakkında</a>
          <a href="/abone/">Abone ol</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
      <div class="foot__row foot__small">
        <span>© {new Date().getFullYear()} (parantez) · {SITE.slogan}</span>
        <span>Konsept çalışma: içerikler örnek, görseller geçicidir.</span>
      </div>
    </footer>
  </div>

  <script>
    const btn = document.querySelector<HTMLButtonElement>('[data-toc-btn]')!;
    const toc = document.querySelector<HTMLElement>('[data-toc]')!;
    const set = (open: boolean) => {
      toc.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', (e) => { e.stopPropagation(); set(toc.hasAttribute('hidden')); });
    document.addEventListener('click', (e) => { if (!toc.hidden && !toc.contains(e.target as Node)) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !toc.hidden) { set(false); btn.focus(); } });

    // Görsel yüklenemezse gri kutu kalsın
    document.querySelectorAll<HTMLImageElement>('.ph img').forEach((img) => {
      const broken = () => img.classList.add('is-broken');
      if (img.complete && img.naturalWidth === 0) broken();
      img.addEventListener('error', broken);
    });
  </script>
</body>
</html>
