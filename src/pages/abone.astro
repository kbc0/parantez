---
import App from '../layouts/App.astro';
import Grp from '../components/Grp.astro';
import { PARANTEZ } from '../lib/site';
---
<App title="Abone ol" description="Her pazartesi 07:30’da haftanın özeti ve beş yazı. Ücretsiz."
  aktif="abone" bar={{ baslik: '(parantez)', alt: 'abone ol', geri: '/' }} mod="abone" kaynak="abone-sayfasi"
  chips={[{ metin: 'Bu haftanın sayısı', href: '/' }, { metin: 'Hakkında', href: '/hakkinda/' }]}>
  <div class="day">abone ol</div>
  <Grp k={PARANTEZ}>
    <p class="b">her pazartesi 07:30’da tek bir e-posta: haftanın özeti ve beş yazı.</p>
    <p class="b">ücretsiz, reklamsız, tek tıkla çıkış. e-postan başka hiçbir şey için kullanılmaz.</p>
    <p class="b">e-posta adresini aşağıya yazar mısın?</p>
  </Grp>
</App>
