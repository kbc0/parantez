---
// Araştırma: yalnızca başlık ve yayınların listesi (numara ve başlık).
import Arastirma from '../../layouts/Arastirma.astro';
import { arastirmalar, arastirmaUrl, pad } from '../../lib/site';

const liste = await arastirmalar();
---
<Arastirma title="Araştırma" description="(parantez) araştırma: ayda bir yayımlanan araştırmalar.">
  <h1 class="ar-baslik">Araştırma</h1>
  {liste.length ? (
    <ol class="ar-liste">
      {liste.map((a) => (
        <li><a href={arastirmaUrl(a)}><span class="ar-no">No. {pad(a.data.no)}</span><span class="ar-liste__t">{a.data.baslik}</span></a></li>
      ))}
    </ol>
  ) : <p class="ar-bos">Henüz yayın yok.</p>}
</Arastirma>
