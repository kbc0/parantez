---
import Base from '../layouts/Base.astro';
import Sec from '../components/Sec.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE } from '../lib/site';
---
<Base title="Hakkında" description="Birkaç kişilik genç bir ekip. Bazen yazıyoruz, bazen çiziyoruz. Gündem uzun, biz kısaltıyoruz. Ara sıra da uzatıyoruz.">
  <Sec as="h1">Hakkında</Sec>

  <p class="about__big">
    birkaç kişilik genç bir ekip. bazen yazıyoruz, bazen çiziyoruz. gündem uzun, biz kısaltıyoruz. ara sıra da uzatıyoruz.
  </p>

  <div class="row about">
    <div>
      <span class="label">ne yapıyoruz</span>
      <p>her pazartesi sabahı gelen kutuna bir bülten bırakıyoruz. içinde haftanın kısa bir özeti ve beş yazı var. haftayı kaçırdıysan on dakikada yakalarsın.</p>
    </div>
    <div>
      <span class="label">nasıl</span>
      <p>bir hafta bekliyoruz. herkes bağırıp çağırmayı bitirince oturup yazıyoruz: ne oldu, neden önemli, sana nereden dokunuyor.</p>
    </div>
    <div>
      <span class="label">bir de</span>
      <p>bazı konular beş paragrafa sığmıyor. o zaman uzatıyoruz. söz, sıkmayacağız.</p>
    </div>
  </div>

  <div class="row about">
    <div>
      <span class="label">bize yaz</span>
      <p>fikrin, itirazın, çizimin ya da bir sorun mu var? <a href={`mailto:${SITE.eposta}`}>{SITE.eposta}</a></p>
    </div>
    <div class="about__sub">
      <span class="label">her pazartesi gelen kutuna gelsin</span>
      <Subscribe variant="page" kaynak="hakkinda" />
    </div>
  </div>
</Base>
