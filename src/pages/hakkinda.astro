---
// Hakkında: ana sayfanın üst menüsüyle açılan sade sayfa (layouts/Sayfa.astro). İçerik sohbet gibi
// (balonlar, tepkiler) ama sohbet düzeni yok: sol liste, üst bar ve mesaj kutusu yok.
import Sayfa from '../layouts/Sayfa.astro';
import Grp from '../components/Grp.astro';
import { SITE, PARANTEZ } from '../lib/site';
---
<Sayfa title="Hakkında" description="Birkaç kişilik genç bir ekip. Gündem uzun, biz kısaltıyoruz. Ara sıra da uzatıyoruz."
  aktif="hakkinda" sayfa="hakkinda">
<main id="icerik" class="msgs hk">
  <div class="day">hakkında</div>
  <div class="me"><p class="b">siz kimsiniz?</p></div>
  <Grp k={PARANTEZ}>
    <p class="b b--baslik" data-tepki="biz">birkaç kişilik genç bir ekip.</p>
    <p class="b" data-tepki="slogan">gündem uzun, biz kısaltıyoruz. ara sıra da uzatıyoruz.</p>
  </Grp>
  <div class="me"><p class="b">ne yapıyorsunuz peki?</p></div>
  <Grp k={PARANTEZ}>
    <p class="b" data-tepki="ne">her pazartesi sabahı gelen kutuna bir bülten bırakıyoruz. içinde haftanın kısa bir özeti ve beş yazı var. haftayı kaçırdıysan on dakikada yakalarsın.</p>
    <p class="b" data-tepki="nasil">bir hafta bekliyoruz. herkes bağırıp çağırmayı bitirince oturup yazıyoruz: ne oldu, neden önemli, sana nereden dokunuyor.</p>
    <p class="b" data-tepki="uzun">bazı konular beş paragrafa sığmıyor. o zaman uzatıyoruz. söz, sıkmayacağız.</p>
    <p class="b" data-tepki="arastirma">ayda bir de bir konuyu sonuna kadar kurcalıyoruz: soruyor, okuyor, sayıyoruz. onlar <a href="/arastirma/">araştırma</a> bölümünde.</p>
  </Grp>
  <div class="me"><p class="b">bunları yapay zekâ mı yazıyor?</p></div>
  <Grp k={PARANTEZ}>
    <p class="b" data-tepki="insan">hayır. burada okuduğun her cümleyi bir insan yazıyor.</p>
    <p class="b" data-tepki="emek">insan emeğinin değerli olduğunu düşünüyoruz. bir konuyu okumak, birilerine sormak, kendi aramızda tartışmak, sonra da sana anlatmak. bu kısmı bir makineye bırakmak istemiyoruz.</p>
    <p class="b" data-tepki="karsi">yapay zekâya karşı değiliz, hatta hakkında yazıyoruz da. ama yazıyı yazan, neyin önemli olduğuna karar veren ve yanılınca özür dileyen biziz.</p>
    <p class="b" data-tepki="hata">yani bir hata görürsen, o da insan hatası. söyle, düzeltelim.</p>
  </Grp>
  <div class="me"><p class="b">size nasıl ulaşırım?</p></div>
  <Grp k={PARANTEZ}>
    <p class="b">fikrin, itirazın ya da bir sorun mu var? <a href={`mailto:${SITE.eposta}`}>{SITE.eposta}</a></p>
  </Grp>
  <section class="hk-abone" data-abone-kutu data-abone-gizle aria-label="Abone ol">
    <Grp k={PARANTEZ} isim={false} cls="grp--devam">
      <p class="b">bülten için e-posta adresini aşağıya yazman yeterli.</p>
    </Grp>
    <form class="yz-abone__form" action="/api/abone" method="post">
      <input type="hidden" name="kaynak" value="hakkinda">
      <input class="hp" type="text" name="web" tabindex="-1" autocomplete="off" aria-hidden="true">
      <label class="sr" for="hk-eposta">E-posta adresin</label>
      <input id="hk-eposta" name="eposta" type="email" inputmode="email" autocomplete="email" enterkeyhint="send" autocapitalize="off" spellcheck="false" placeholder="e-posta adresin" required>
      <button class="send" type="submit" aria-label="Abone ol">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
      </button>
    </form>
    <p class="yz-abone__uyari" data-uyari hidden role="status"></p>
  </section>
</main>

<div class="picker" data-picker hidden role="dialog" aria-label="Tepki seç"></div>
<div class="toast" data-toast hidden role="status"></div>
<script>
  import '../scripts/ortak';
  import '../scripts/sohbet';
</script>
</Sayfa>
