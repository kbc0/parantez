---
// Ana sayfa: bu haftanın kapağı (SayiKapak). Masaüstünde tek ekrana sığar ve kaymaz; telefonda
// alt alta dizilir. Bütün sayılar ve konular çekmecede (popover): üstteki "Arşiv" / "Menü" açar.
import App from '../layouts/App.astro';
import AnaUst from '../components/AnaUst.astro';
import SayiKapak from '../components/SayiKapak.astro';
import { sayilar } from '../lib/site';
import { siteLd } from '../lib/yapisal';

const liste = await sayilar();
const g = liste[0];
---
<App composer={false} ana meta={{ ld: siteLd(Astro.site!) }}
  bar={{ baslik: '(parantez)', alt: `her pazar 09:00 · ${liste.length} sayı`, kok: true }}>
  <AnaUst />
  {g && <SayiKapak sayi={g} guncel />}
</App>
