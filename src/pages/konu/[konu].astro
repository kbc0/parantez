---
import App from '../../layouts/App.astro';
import Grp from '../../components/Grp.astro';
import LinkCard from '../../components/LinkCard.astro';
import { yazilar, sayilar, pad, okumaSuresi, PARANTEZ, type Yazi, type Sayi } from '../../lib/site';
import { KONULAR } from '../../lib/konular';
import { GENEL } from '../../lib/chips';

export async function getStaticPaths() {
  const [ys, ss] = await Promise.all([yazilar(), sayilar()]);
  return Object.entries(KONULAR)
    .map(([k, ad]) => ({ params: { konu: k }, props: { k, ad, liste: ys.filter((y) => y.data.konu === k), sayilar: ss } }))
    .filter((p) => p.props.liste.length > 0);
}

const { k, ad, liste } = Astro.props as { k: string; ad: string; liste: Yazi[]; sayilar: Sayi[] };
const etiket = ad.toLocaleLowerCase('tr');
---
<App title={ad} description={`(parantez)’te ${etiket} üzerine bütün yazılar.`} aktif={`konu-${k}`}
  bar={{ baslik: `#${etiket}`, alt: `${liste.length} yazı`, geri: '/arsiv/' }} chips={GENEL}>
  <div class="day">#{etiket}</div>
  <Grp k={PARANTEZ}>
    <p class="b">{etiket} üzerine {liste.length} yazı, en yeniden eskiye:</p>
    {liste.map((y) => <LinkCard yazi={y} etiket={`Sayı ${pad(y.data.sayi)} · ${okumaSuresi(y)} dk · ${y.data.yazar}`} />)}
  </Grp>
</App>
