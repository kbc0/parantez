---
// Konu sayfası: o konudaki bütün yazılar, en yeniden eskiye. Ana sayfanın üst menüsüyle sade sayfa.
import Sayfa from '../../layouts/Sayfa.astro';
import { yazilar, pad, okumaSuresi, yaziUrl, ilkAd, type Yazi } from '../../lib/site';
import { KONULAR, konuRenk } from '../../lib/konular';

export async function getStaticPaths() {
  const ys = await yazilar();
  return Object.entries(KONULAR)
    .map(([k, ad]) => ({ params: { konu: k }, props: { k, ad, liste: ys.filter((y) => y.data.konu === k) } }))
    .filter((p) => p.props.liste.length > 0);
}

const { k, ad, liste } = Astro.props as { k: string; ad: string; liste: Yazi[] };
const etiket = ad.toLocaleLowerCase('tr');
---
<Sayfa title={ad} description={`(parantez)’te ${etiket} üzerine bütün yazılar.`}>
<main id="icerik" class="sade" style={`--c:${konuRenk(k)}`}>
  <p class="sade__ust">Konu · {liste.length} yazı</p>
  <h1 class="sade__baslik">#{etiket}</h1>
  <ol class="kapak__yazilar sade__liste">
    {liste.map((y) => (
      <li>
        <a href={yaziUrl(y)} style={`--c:${konuRenk(y.data.konu)}`}>
          <span class="kapak__t">
            <b>{y.data.baslik}</b>
            <span class="sade__spot">{y.data.spot}</span>
            <small>Sayı {pad(y.data.sayi)} · {okumaSuresi(y)} dk · {ilkAd(y.data.yazar)}</small>
          </span>
        </a>
      </li>
    ))}
  </ol>
</main>
<script>import '../../scripts/ortak';</script>
</Sayfa>
