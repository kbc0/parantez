---
import App from '../../layouts/App.astro';
import IssueChat from '../../components/IssueChat.astro';
import { sayilar, pad, type Sayi } from '../../lib/site';
import { sayiChips } from '../../lib/chips';

export async function getStaticPaths() {
  const liste = await sayilar();
  return liste.map((s, i) => ({ params: { no: String(s.data.sayi) }, props: { sayi: s, guncel: i === 0 } }));
}

const { sayi, guncel } = Astro.props as { sayi: Sayi; guncel: boolean };
const s = sayi.data;
const disari = !!(s.oneriler && Object.keys(s.oneriler).length) || !!s.etkinlikler?.length;
---
<App
  title={`Sayı ${pad(s.sayi)}: ${s.baslik}`}
  description={`Sayı ${pad(s.sayi)}: ${s.baslik}`}
  sayfa={`sayi-${s.sayi}`}
  aktif={`sayi-${s.sayi}`}
  bar={{ baslik: `Sayı ${pad(s.sayi)}`, alt: s.baslik, geri: '/arsiv/' }}
  chips={sayiChips({ disari, arsiv: !guncel })}
>
  <IssueChat sayi={sayi} arsiv={!guncel} />
</App>
