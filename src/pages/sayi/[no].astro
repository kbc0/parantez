---
// Bir sayının sayfası: ana sayfadaki kapağın aynısı (SayiKapak). Bu haftanın sayısı ana sayfayla aynıdır;
// aramalarda ana sayfa gösterilsin diye asıl adresi (canonical) "/" olur. Eski sayılarda "arşiv" yazar.
import App from '../../layouts/App.astro';
import AnaUst from '../../components/AnaUst.astro';
import SayiKapak from '../../components/SayiKapak.astro';
import { sayilar, pad, kisaMetin, type Sayi } from '../../lib/site';

export async function getStaticPaths() {
  const liste = await sayilar();
  return liste.map((s, i) => ({ params: { no: String(s.data.sayi) }, props: { sayi: s, guncel: i === 0 } }));
}

const { sayi, guncel } = Astro.props as { sayi: Sayi; guncel: boolean };
const s = sayi.data;
---
<App
  title={`Sayı ${pad(s.sayi)}: ${s.baslik}`}
  description={kisaMetin((sayi.body ?? '').trim().split(/\n\s*\n/)[0] ?? '') || `Sayı ${pad(s.sayi)}: ${s.baslik}`}
  kanonik={guncel ? '/' : undefined}
  composer={false}
  ana
  bar={{ baslik: '(parantez)', kok: true }}
>
  <AnaUst />
  <SayiKapak sayi={sayi} guncel={guncel} />
</App>
