---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { yazilar, sayilar, okumaSuresi, gorsel, pad, tarihUzun, tarihKisa, sayiUrl, konuUrl, type Yazi, type Sayi } from '../../lib/site';
import { konuAdi } from '../../lib/konular';

export async function getStaticPaths() {
  const [ys, ss] = await Promise.all([yazilar(), sayilar()]);
  return ys.map((y) => ({ params: { slug: y.id }, props: { yazi: y, sayi: ss.find((s) => s.data.sayi === y.data.sayi)! } }));
}

const { yazi, sayi } = Astro.props as { yazi: Yazi; sayi: Sayi };
const d = yazi.data;
const { Content } = await render(yazi);
const dk = okumaSuresi(yazi);
const hero = gorsel(d.gorsel, 1600, 900);
---
<Base title={d.baslik} description={d.spot} image={gorsel(d.gorsel, 1200, 630)} type="article">
  <div class="progress" aria-hidden="true"><i data-progress></i></div>

  <article class="art">
    <a class="back" href={sayiUrl(d.sayi)}>← Sayı {pad(d.sayi)} · {sayi.data.baslik}</a>

    <div class="meta art__meta">
      <a class="cat" href={konuUrl(d.konu)}>{konuAdi(d.konu)}</a>
      <time class="meta__big" datetime={sayi.data.yayin.toISOString().slice(0, 10)}>{tarihKisa(sayi.data.yayin)}</time>
    </div>

    <h1 class="art__title">{d.baslik}</h1>

    <div class="art__grid">
      <aside class="art__side">
        <div class="art__sticky">
          <dl class="facts">
            <div><dt>Yazan</dt><dd>{d.yazar}</dd></div>
            <div><dt>Okuma</dt><dd>{dk} dk</dd></div>
            <div><dt>Yayın</dt><dd>{tarihUzun(sayi.data.yayin)}</dd></div>
            <div><dt>Sayı</dt><dd><a href={sayiUrl(d.sayi)}>{pad(d.sayi)}</a></dd></div>
            {d.podcast && <div><dt>Dinle</dt><dd><a href={d.podcast}>Podcast →</a></dd></div>}
          </dl>
          <div class="points">
            <h2>Kısaca</h2>
            <ol>{d.kisaca.map((p) => <li>{p}</li>)}</ol>
          </div>
        </div>
      </aside>

      <div class="art__body">
        <p class="art__lede">{d.spot}</p>
        <figure class="art__fig">
          <div class="ph ph--wide"><img src={hero} alt={d.gorselAlt} width="1600" height="900" fetchpriority="high"></div>
          <figcaption>{d.gorselKaynak}</figcaption>
        </figure>
        <div class="prose"><Content /></div>
        <div class="why">
          <h2>Neden önemli?</h2>
          <p>{d.neden}</p>
        </div>
        <div class="art__end">
          <a href={sayiUrl(d.sayi)}>← Sayı {pad(d.sayi)} · tüm yazılar</a>
          <button type="button" class="share" data-share>Bağlantıyı kopyala</button>
        </div>
      </div>
    </div>
  </article>

  <script>
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const art = document.querySelector<HTMLElement>('.art');
    if (bar && art) {
      const update = () => {
        const r = art.getBoundingClientRect();
        const total = r.height - window.innerHeight;
        const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
        bar.style.transform = `scaleX(${p})`;
      };
      addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
      update();
    }

    const share = document.querySelector<HTMLButtonElement>('[data-share]');
    share?.addEventListener('click', async () => {
      const url = location.href.split('#')[0];
      try {
        if (navigator.share && matchMedia('(pointer: coarse)').matches) {
          await navigator.share({ title: document.title, url });
          return;
        }
        await navigator.clipboard.writeText(url);
        share.textContent = 'Kopyalandı ✓';
      } catch {
        share.textContent = url;
      }
      setTimeout(() => (share.textContent = 'Bağlantıyı kopyala'), 2500);
    });
  </script>
</Base>
