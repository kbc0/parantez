---
// Yazı sayfası: sohbetten açılan, balonsuz ve rahat okunan sayfa.
// Sohbetle bağı: aynı üst bar, yazarın avatarı ve (parantez)'in kenara düştüğü notlar.
import { render } from 'astro:content';
import App from '../../layouts/App.astro';
import Av from '../../components/Av.astro';
import { yazilar, sayilar, sayininYazilari, okumaSuresi, gorsel, pad, tarihUzun, sayiUrl, yaziUrl, kisi, ilkAd, PARANTEZ, type Yazi, type Sayi } from '../../lib/site';
import { konuAdi, konuRenk } from '../../lib/konular';

export async function getStaticPaths() {
  const [ys, ss] = await Promise.all([yazilar(), sayilar()]);
  return ys.map((y) => ({ params: { slug: y.id }, props: { yazi: y, sayi: ss.find((s) => s.data.sayi === y.data.sayi)! } }));
}

const { yazi, sayi } = Astro.props as { yazi: Yazi; sayi: Sayi };
const d = yazi.data;
const { Content } = await render(yazi);
const dk = okumaSuresi(yazi);
const yazar = kisi(d.yazar);
const kardesler = await sayininYazilari(d.sayi);
const i = kardesler.findIndex((y) => y.id === yazi.id);
const sonraki = kardesler[i + 1];
const sayiLink = sayiUrl(d.sayi);
const EMOJI = ['❤️', '😂', '😮', '😢', '🔥'];
// Sohbetteki link kartıyla aynı görsel: önbellekten gelir, kart görsele dönüşür
const foto = (y: Yazi) => gorsel(y.data.gorsel, 1200, 632);
---
<App
  title={d.baslik}
  description={d.spot}
  image={gorsel(d.gorsel, 1200, 630)}
  type="article"
  sayfa={`yazi-${yazi.id}`}
  aktif={`sayi-${d.sayi}`}
  bar={{
    baslik: `Sayı ${pad(d.sayi)}`,
    alt: `yazı ${i + 1}/${kardesler.length} · ${konuAdi(d.konu).toLocaleLowerCase('tr')}`,
    geri: sayiLink,
    ikinci: { kisi: yazar, baslik: d.baslik, alt: `${ilkAd(yazar.ad)} · {kalan}` },
    paylas: true,
  }}
  composer={false}
  okuma
>
  <article class="yz" data-dk={dk} style={`--c:${konuRenk(d.konu)}`}>
    <header class="yz__bas">
      <p class="yz__ust">
        <a class="yz__konu" href={`/konu/${d.konu}/`}>{konuAdi(d.konu)}</a>
        <span>Sayı {pad(d.sayi)} · {i + 1}/{kardesler.length}</span>
      </p>
      <h1 class="yz__baslik">{d.baslik}</h1>
      <p class="yz__spot">{d.spot}</p>
      <div class="yz__imza">
        <Av k={yazar} />
        <span><b>{yazar.ad}</b><small>{tarihUzun(sayi.data.yayin)} · {dk} dk okuma</small></span>
      </div>
    </header>

    <figure class="yz__foto">
      <span class="yz__g"><img src={foto(yazi)} alt={d.gorselAlt} width="1200" height="632" fetchpriority="high" style={`view-transition-name: foto-${yazi.id}`}></span>
      {d.gorselKaynak && <figcaption>{d.gorselKaynak}</figcaption>}
    </figure>

    <aside class="not" aria-label="Kısaca">
      <Av k={PARANTEZ} />
      <div class="not__b">
        <b class="not__e">Kısaca</b>
        <ol>{d.kisaca.map((k) => <li>{k}</li>)}</ol>
      </div>
    </aside>

    <div class="yz__metin">
      <Content />
    </div>

    <aside class="not not--neden" aria-label="Neden önemli?">
      <Av k={PARANTEZ} />
      <div class="not__b">
        <b class="not__e">Neden önemli?</b>
        <p>{d.neden}</p>
      </div>
    </aside>

    <footer class="yz__son">
      <p class="bitti" data-son><span>(son)</span><span class="bitti__ok">okundu ✓✓</span></p>

      <div class="yz-tepki" data-yazi-tepki hidden>
        <p>bu yazı nasıldı?</p>
        <div>{EMOJI.map((e) => <button type="button" data-e={e} aria-pressed="false">{e}<span></span></button>)}</div>
      </div>

      {sonraki
        ? (
          <a class="sonraki" href={yaziUrl(sonraki)} data-slug={sonraki.id}>
            <span class="sonraki__t">
              <small>Sıradaki · {i + 2}/{kardesler.length} · {okumaSuresi(sonraki)} dk</small>
              <b>{sonraki.data.baslik}</b>
              <span>{sonraki.data.yazar} · {konuAdi(sonraki.data.konu)}</span>
            </span>
            <span class="sonraki__g"><img src={foto(sonraki)} alt="" width="1200" height="632" loading="lazy" decoding="async" style={`view-transition-name: foto-${sonraki.id}`}></span>
          </a>
        )
        : (
          <a class="sonraki sonraki--son" href={sayiLink}>
            <span class="sonraki__t">
              <small>Bu sayının son yazısıydı</small>
              <b>Sayı {pad(d.sayi)} sohbetine dön</b>
              <span>özet, öneriler ve etkinlikler orada</span>
            </span>
          </a>
        )}

      <section class="yz-abone" data-abone-kutu data-abone-gizle aria-label="Abone ol">
        <div class="not">
          <Av k={PARANTEZ} />
          <div class="not__b"><p>bu yazı her pazartesi 07:30’da gelen bültenimizden. sana da gelsin mi?</p></div>
        </div>
        <form class="yz-abone__form" action="/api/abone" method="post">
          <input type="hidden" name="kaynak" value={`yazi-${yazi.id}`}>
          <input class="hp" type="text" name="web" tabindex="-1" autocomplete="off" aria-hidden="true">
          <label class="sr" for="yz-eposta">E-posta adresin</label>
          <input id="yz-eposta" name="eposta" type="email" inputmode="email" autocomplete="email" enterkeyhint="send" autocapitalize="off" spellcheck="false" placeholder="e-posta adresin" required>
          <button class="send" type="submit" aria-label="Abone ol">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
          </button>
        </form>
        <p class="yz-abone__uyari" data-uyari hidden role="status"></p>
      </section>
    </footer>
  </article>

</App>
