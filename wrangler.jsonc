{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parantez",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // `wrangler deploy` önce siteyi derler (dist/), sonra yükler.
  // Paketler kurulu değilse (ör. Cloudflare build ortamı) önce kurar.
  "build": { "command": "(test -d node_modules/astro || npm ci) && npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // /api/* istekleri (form gönderimleri dahil) her zaman önce Worker'a gider
    "run_worker_first": ["/api/*"]
  },
  // Eski abone listesi. Aboneler artık D1'de; buradakiler bir kez D1'e taşınır (worker/abonelik.js).
  "kv_namespaces": [{ "binding": "ABONELER" }],
  // Tepkiler, aboneler, panel hesapları ve gönderimler. Tablolar ilk istekte kurulur.
  "d1_databases": [{ "binding": "DB", "database_name": "parantez-tepkiler" }],
  // Yazı paneli içerikleri bu depoya commit eder. GITHUB_TOKEN, YONETICI_EPOSTA, YONETICI_PAROLA
  // ve RESEND_API_KEY Cloudflare panelinde gizli değişken (secret) olarak tanımlanır.
  "vars": {
    "GITHUB_REPO": "kbc0/parantez",
    "GITHUB_DAL": "main",
    "SITE_ADRESI": "https://parantezbulten.com",
    "BULTEN_KIMDEN": "(parantez) <bulten@parantezbulten.com>",
    "BULTEN_YANIT": "baris@parantezbulten.com"
  },
  // Her dakika: planlanan bülteni yayınlar ve gönderir (worker/gonderim.js)
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
